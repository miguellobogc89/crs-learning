/// Operación en el bróker con stop y objetivo: el stop vive en el bróker y el objetivo lo vigila la app.
model trading_broker_brackets {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String @db.Uuid
  broker String @default("trading212_demo")
  /// Conexión (broker_connections) con la que se abrió.
  connection_id String? @db.Uuid
  symbol String
  ticker String
  name String
  quantity Float
  stop Float
  target Float
  planned_price Float
  status String @default("esperando_entrada")
  entry_order_id String?
  stop_order_id String?
  exit_order_id String?
  entry_price Float?
  exit_price Float?
  exit_reason String?
  note String?
  source String @default("manual")
  proposal_id String? @db.Uuid
  last_checked_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  @@index([workspace_id, status])
}

/// Conexión de un usuario con un bróker. El entorno (demo/real) se fija al crearla y nunca cambia.
/// Las credenciales van cifradas (lib/connectors/crypto) y jamás salen hacia el navegador.
model broker_connections {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String          @db.Uuid
  workspace_id       String          @db.Uuid
  provider           String
  environment        String
  /// active | error | disconnected
  status             String          @default("active")
  account_id         String?
  account_label      String?
  currency           String?
  /// read | trade | auto
  permissions        String[]        @default(["read"])
  credentials_enc    String?
  /// stored = cifradas en la base de datos; server = del .env del servidor (solo desarrollo y demo)
  credentials_source String          @default("stored")
  last_error         String?
  last_checked_at    DateTime?       @db.Timestamptz(6)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  orders             broker_orders[]

  @@unique([user_id, workspace_id, provider, environment], map: "broker_connections_owner_unique")
  @@index([workspace_id], map: "broker_connections_workspace_idx")
}

/// Registro auditable de cada orden pedida a un bróker y su resultado. La clave de idempotencia
/// impide enviar dos veces la misma intención por la misma conexión.
model broker_orders {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connection_id     String             @db.Uuid
  user_id           String             @db.Uuid
  workspace_id      String             @db.Uuid
  provider          String
  environment       String
  /// usuario | nombre del automatismo
  actor             String
  idempotency_key   String
  reference         String?
  symbol            String
  market            String
  provider_symbol   String?
  side              String
  type              String
  quantity          Float
  limit_price       Float?
  stop_price        Float?
  time_in_force     String?
  status            String             @default("pending_submit")
  provider_order_id String?
  provider_status   String?
  error_code        String?
  error_message     String?
  response_json     Json?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  connection        broker_connections @relation(fields: [connection_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "broker_orders_connection_fkey")

  @@unique([connection_id, idempotency_key], map: "broker_orders_idempotency_unique")
  @@index([user_id, created_at], map: "broker_orders_user_idx")
}

/// Ronda de un agente kamikaze: capital de partida, meta (capital × N) y plazo. en_curso | meta | plazo | arruinado.
model trading_kamikaze_rounds {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent               String
  number              Int
  status              String    @default("en_curso")
  start_capital       Float
  goal                Float
  started_at          DateTime  @default(now()) @db.Timestamptz(6)
  deadline            DateTime  @db.Timestamptz(6)
  ended_at            DateTime? @db.Timestamptz(6)
  end_equity          Float?
  best_equity         Float?
  trades              Int       @default(0)
  last_decision_at    DateTime? @db.Timestamptz(6)
  last_decision_price Float?
  cooldown_until      DateTime? @db.Timestamptz(6)
  /// Qué pasó en la última revisión: por qué no entró o en qué entró.
  last_note           String?
  last_note_at        DateTime? @db.Timestamptz(6)

  @@unique([agent, number], map: "trading_kamikaze_rounds_agent_number")
  @@index([agent, status], map: "trading_kamikaze_rounds_agent_status")
}

/// FARO: cada análisis del mercado cripto (una llamada a la IA para todos los agentes).
model trading_faro_runs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  status      String   @default("en_curso")
  /// 'crypto' o 'us' (bolsa de EE. UU.): cada ámbito tiene sus propios análisis.
  scope       String   @default("crypto")
  /// Versión de FARO (reglas y prompt) que hizo este análisis: para comparar versiones.
  version     String?
  market_view String?
  ideas       Int      @default(0)
  error       String?

  @@index([created_at], map: "trading_faro_runs_created_at")
}

/// FARO: ideas del tablón común, con su resultado una vez resueltas (acierto, fallo o caducada).
model trading_faro_ideas {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id       String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  pair         String
  symbol       String
  kind         String
  conviction   Int
  price        Float
  invalidation Float
  target       Float
  valid_until  DateTime  @db.Timestamptz(6)
  rationale    String
  risks        String?
  status       String    @default("viva")
  last_price   Float?
  best_pct     Float?
  worst_pct    Float?
  exit_price   Float?
  result_pct   Float?
  resolved_at  DateTime? @db.Timestamptz(6)
  checked_at   DateTime? @db.Timestamptz(6)

  @@index([status], map: "trading_faro_ideas_status")
  @@index([created_at], map: "trading_faro_ideas_created_at")
}

/// Copia de un agente en tu bróker: presupuesto en euros y modo (ensayo | real).
model trading_mirrors {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String                @db.Uuid
  agent        String
  budget       Float
  mode         String                @default("ensayo")
  active       Boolean               @default(true)
  /// En pausa: no compra nada nuevo; lo que tiene se sigue vendiendo cuando el agente sale.
  paused       Boolean               @default(false)
  started_at   DateTime              @default(now()) @db.Timestamptz(6)
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at   DateTime              @default(now()) @db.Timestamptz(6)
  legs         trading_mirror_legs[]

  @@unique([workspace_id, agent], map: "trading_mirrors_workspace_agent")
}

/// Cada posición del agente copiada: abriendo | abierta | vendiendo | cerrada | omitida | error.
model trading_mirror_legs {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mirror_id          String          @db.Uuid
  source_position_id String          @db.Uuid
  mode               String
  symbol             String
  pair               String?
  status             String          @default("abriendo")
  amount             Float?
  quantity           Float?
  entry_price        Float?
  exit_price         Float?
  result             Float?
  buy_order_id       String?
  sell_order_id      String?
  sell_attempts      Int             @default(0)
  note               String?
  opened_at          DateTime?       @db.Timestamptz(6)
  closed_at          DateTime?       @db.Timestamptz(6)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  mirror             trading_mirrors @relation(fields: [mirror_id], references: [id], onDelete: Cascade, map: "trading_mirror_legs_mirror_fkey")

  @@unique([mirror_id, source_position_id], map: "trading_mirror_legs_source")
  @@index([mirror_id, status], map: "trading_mirror_legs_status")
}

/// Mis operaciones: compras tuyas desde Oportunidades con dinero real; la app vigila stop y objetivo.
model trading_manual_trades {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String    @db.Uuid
  idea_id       String?   @db.Uuid
  symbol        String
  pair          String?
  status        String    @default("abriendo")
  amount        Float
  quantity      Float?
  entry_price   Float?
  stop          Float
  initial_stop  Float
  target        Float
  trail         Boolean   @default(false)
  trailing      Boolean   @default(false)
  exit_price    Float?
  result        Float?
  buy_order_id  String?
  sell_order_id String?
  sell_attempts Int       @default(0)
  note          String?
  opened_at     DateTime? @db.Timestamptz(6)
  closed_at     DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([workspace_id, status], map: "trading_manual_trades_ws_status")
}

/// Agentes de cada usuario (espacio): como mucho 3. Siguen siendo públicos; esto dice de quién son.
model trading_user_agents {
  workspace_id String   @db.Uuid
  agent        String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@id([workspace_id, agent])
}

/// Saldo de cada exchange conectado, una foto por día (la última del día).
model trading_wallet_snapshots {
  connection_id String   @db.Uuid
  workspace_id  String   @db.Uuid
  day           DateTime @db.Date
  total         Float
  currency      String   @default("EUR")
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([connection_id, day])
  @@index([workspace_id, day], map: "trading_wallet_snapshots_workspace_day_idx")
}

/// Valor total en EUR de los exchanges reales de un usuario, agrupado en franjas de 5 minutos.
/// El saldo incluye aportaciones y retiradas: NO es una serie de rentabilidad.
model trading_wallet_intraday {
  user_id     String   @db.Uuid
  workspace_id String  @db.Uuid
  sampled_at  DateTime @db.Timestamptz(6)
  total       Float

  @@id([user_id, workspace_id, sampled_at])
  @@index([workspace_id, sampled_at(sort: Desc)], map: "trading_wallet_intraday_workspace_time_idx")
}

/// Consentimientos bancarios personales: pertenecen a una persona, nunca a un workspace.
/// Los identificadores de sesión y de cuenta se almacenan cifrados; no se guardan movimientos.
model personal_bank_connections {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid
  bank                String
  institution_name    String
  session_id_enc      String
  account_ids_enc     String
  consent_expires_at  DateTime @db.Timestamptz(6)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, bank])
  @@index([user_id])
}
